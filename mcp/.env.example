# ---------------------------------------------------------------- Conexión --
# URL base de la API CodeVote (incluye /api).
CODEVOTE_API_URL=http://localhost:3000/api

# Sesión del MCP. La API entra con un código de un solo uso enviado al correo
# institucional, así que el servidor no puede autenticarse solo: se le da un JWT
# ya emitido. Genéralo con:
#
#     npm run token
#
# El token no llega nunca al modelo. Cuando caduca hay que generar otro: no hay
# renovación automática posible, porque el código lo lee una persona.
# Recomendación: usa una cuenta con el rol MÍNIMO necesario, no la cuenta
# personal del administrador.
CODEVOTE_TOKEN=

# ---------------------------------------------------------------- Política --
# lectura (por defecto) | escritura
# En modo lectura las herramientas de administración NI SIQUIERA SE REGISTRAN.
CODEVOTE_MCP_MODE=lectura

# Enmascarar cédulas y correos antes de entregarlos al modelo.
CODEVOTE_MCP_REDACT_PII=true

# Permitir http:// contra un host remoto. Solo para pruebas: sin TLS el JWT
# viaja en claro.
CODEVOTE_MCP_ALLOW_INSECURE_HTTP=false

# ----------------------------------------------------------------- Límites --
CODEVOTE_MCP_TIMEOUT_MS=8000
CODEVOTE_MCP_MAX_BYTES=262144
CODEVOTE_MCP_MAX_ITEMS=50
CODEVOTE_MCP_RATE_MAX=60
CODEVOTE_MCP_RATE_WINDOW_MS=60000

# -------------------------------------------------------------- Transporte --
# stdio (por defecto, recomendado) | http
CODEVOTE_MCP_TRANSPORT=stdio

# Solo para CODEVOTE_MCP_TRANSPORT=http
CODEVOTE_MCP_HTTP_HOST=127.0.0.1
CODEVOTE_MCP_HTTP_PORT=3333
# Obligatorio en http, mínimo 32 caracteres. Genéralo con:
#   node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
CODEVOTE_MCP_HTTP_TOKEN=
# Orígenes de navegador admitidos, separados por coma. Si se deja vacío solo se
# aceptan los orígenes de loopback del propio servidor.
CODEVOTE_MCP_HTTP_ORIGINS=

# ------------------------------------------------------------------- Logs --
# debug | info | warn | error | silent. Siempre salen por stderr.
CODEVOTE_MCP_LOG_LEVEL=info
