{
  "name": "codevote-mcp",
  "version": "1.0.0",
  "description": "Servidor MCP de la API CodeVote: expone el proceso electoral a asistentes de IA con una política de seguridad explícita.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "codevote-mcp": "dist/index.js"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "node --import tsx --test test/*.test.ts",
    "inspector": "npx -y @modelcontextprotocol/inspector node --env-file-if-exists=.env dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": ["mcp", "codevote", "model-context-protocol"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
