# Servidor
PORT=3000
# Interfaz de escucha. 0.0.0.0 expone el servicio fuera del contenedor/host.
HOST=0.0.0.0

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=codevote_db

# Autenticación (usar una cadena larga y distinta en cada entorno)
JWT_SECRET=cambia_esto_por_una_cadena_segura_de_minimo_32_caracteres
# El acceso es por código al correo, no por contraseña: la sesión dura más para
# que nadie tenga que pedir un código nuevo a media votación.
JWT_EXPIRES_IN=8h

# Puerta de emergencia: reactiva POST /api/auth/login con contraseña. Déjalo sin
# definir (o en false) salvo que el SMTP esté caído y la administración necesite
# entrar. Con OTP activo, ese endpoint responde 410.
AUTH_PASSWORD_FALLBACK=false

# Orígenes permitidos por CORS, separados por coma.
# Si se deja vacío se permite cualquier origen (solo para pruebas locales).
CORS_ORIGIN=https://codevote.lat

# Límites de peticiones (por IP). Opcionales: si no se definen se usan estos
# mismos valores por defecto.
# RATE_LIMIT_WINDOW_MIN: ventana en minutos para ambos límites.
# RATE_LIMIT_MAX: peticiones permitidas a toda la API por ventana.
# LOGIN_RATE_LIMIT_MAX: canjes de código FALLIDOS por ventana (los exitosos no
#   cuentan). Subirlo demasiado debilita la protección contra fuerza bruta.
# CODIGO_RATE_LIMIT_MAX: solicitudes de código por ventana y por IP. Aquí sí
#   cuentan las correctas, porque cada una envía un correo. Se deja holgado
#   porque toda una sala puede compartir la IP de la red del campus.
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=1000
LOGIN_RATE_LIMIT_MAX=30
CODIGO_RATE_LIMIT_MAX=60

# Directorio donde se guardan los archivos subidos (planes de trabajo en PDF).
# DEBE ser un volumen persistente montado en el contenedor: si apunta a una ruta
# interna sin volumen, los archivos se pierden en cada redespliegue.
# Se sirven públicamente en https://<host>/api/uploads/planes/...
UPLOADS_DIR=/app/uploads

# --- Correo saliente (SMTP) -------------------------------------------------
# OBLIGATORIO desde el inicio de sesión por código: sin SMTP nadie puede entrar,
# porque el código de acceso llega por correo. En desarrollo, si no está
# configurado, el código se escribe en el log del servidor para poder seguir
# trabajando; en producción la solicitud responde 503.
# También se usa para los avisos de cierre a la administración.
# NO pongas credenciales reales en este archivo: van en el .env del servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Remitente que verá quien recibe el correo. Si se deja vacío se usa SMTP_USER.
SMTP_FROM=CodeVote <no-reply@codevote.lat>
# true = TLS directo (puerto 465). Por defecto STARTTLS sobre el 587.
SMTP_SECURE=false

# Enlace a los resultados que se incluye en ese correo.
URL_RESULTADOS_ADMIN=https://codevote.lat/admin/resultados
